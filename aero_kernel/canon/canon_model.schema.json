{
  "$defs": {
    "Application": {
      "additionalProperties": false,
      "description": "A formula applied to concrete quantities, written out completely (ch. 8.5).\n\n``bind`` and ``produce`` hold the merged result of the formula's defaults and the application's\nown overrides, so every input parameter is bound and every output parameter is produced.\n\nAttributes:\n    id: Name of the application, unique within its formula; ``default`` for the implicit one.\n    bind: Quantity or constant per input parameter.\n    produce: Quantity per output parameter; ``None`` = the application does not expose it.\n    when: Condition over the geometry; ``None`` = always.\n    given: Quantities that must be supplied for the application to exist; ``None`` = always.\n        Each must be bound by the application, but ``Formula`` checks that, not this type: an\n        ``Application`` alone does not guarantee ``given`` is a subset of its bindings. The\n        check runs after the bindings and the field rules, so a ``given`` fault of a formula\n        that has other faults is deferred to the next run; it is never hidden.",
      "properties": {
        "bind": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(_[a-z0-9]+)*$": {
              "oneOf": [
                {
                  "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/ConstBinding"
                }
              ]
            }
          },
          "title": "Bind",
          "type": "object"
        },
        "given": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Given"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*([_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "produce": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(_[a-z0-9]+)*$": {
              "anyOf": [
                {
                  "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "title": "Produce",
          "type": "object"
        },
        "when": {
          "anyOf": [
            {
              "enum": [
                "has_aileron",
                "has_elevator",
                "has_flap",
                "has_horizontal_tail",
                "has_rudder",
                "has_separate_flap_and_aileron",
                "has_vertical_tail"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "required": [
        "id",
        "bind",
        "produce"
      ],
      "title": "Application",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "description": "A pre- or postcondition of a formula (ch. 8.5).\n\nAttributes:\n    id: Name of the check, unique among the formula's checks of its kind.\n    parameter: The input (precondition) or output (postcondition) parameter it concerns.\n    on_violation: ``error`` withholds the value, ``warning`` returns it with a defect warning.\n    applications: Ids of the applications it belongs to; ``None`` = all of them.",
      "properties": {
        "applications": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9]*([_-][a-z0-9]+)*$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applications"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*([_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "on_violation": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "On Violation",
          "type": "string"
        },
        "parameter": {
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
          "title": "Parameter",
          "type": "string"
        }
      },
      "required": [
        "id",
        "parameter",
        "on_violation"
      ],
      "title": "Check",
      "type": "object"
    },
    "ConfigValue": {
      "additionalProperties": false,
      "description": "One tolerance of the configuration.\n\nAttributes:\n    value: The tolerance, a finite number greater than zero, in ``unit``.\n    unit: Its unit; ``1`` is dimensionless.\n    guards: What the check decides.\n    basis: ``solver-precision`` (the digits a tool prints), ``decision`` (fixed by the\n        maintainer) or ``numerical`` (a margin over floating-point noise).\n    source: Where the value comes from.",
      "properties": {
        "basis": {
          "pattern": "^(solver-precision|decision|numerical)$",
          "title": "Basis",
          "type": "string"
        },
        "guards": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Guards",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit",
        "guards",
        "basis",
        "source"
      ],
      "title": "ConfigValue",
      "type": "object"
    },
    "ConstBinding": {
      "additionalProperties": false,
      "description": "A constant bound to an input parameter, with its source (ADR 0028).\n\nAttributes:\n    const: The value, in the parameter's unit.\n    source: Citation of where the constant comes from.",
      "properties": {
        "const": {
          "title": "Const",
          "type": "number"
        },
        "source": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "const",
        "source"
      ],
      "title": "ConstBinding",
      "type": "object"
    },
    "Default": {
      "additionalProperties": false,
      "description": "A value the canon states for a supplied quantity or a catalogue read, with its unit, basis, source and regime.\n\nAttributes:\n    value: The value, in ``unit``.\n    unit: The unit of ``value``; it must equal the unit of the quantity.\n    basis: ``definition`` (true by definition), ``standard`` (a published standard value),\n        ``sourced`` (taken from a cited source), ``convention`` (chosen, no published source,\n        adopted on the maintainer's word) or ``start`` (a defined starting value for a design,\n        expected to be changed by the designer; it may be sourced).\n    source: Citation of where the value comes from (ADR 0028).\n    regime: The flight regime the value is valid for (ADR 0028).",
      "properties": {
        "basis": {
          "enum": [
            "definition",
            "standard",
            "sourced",
            "convention",
            "start"
          ],
          "title": "Basis",
          "type": "string"
        },
        "regime": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Regime",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "enum": [
            "1",
            "m",
            "m^2",
            "kg",
            "s",
            "deg",
            "deg/s",
            "m/s",
            "m/s^2",
            "1/s",
            "1/rad",
            "1/rad^2",
            "N",
            "N/m^2",
            "N*m",
            "N/m",
            "Pa",
            "Pa*s",
            "kg/m^3",
            "W",
            "V",
            "A",
            "ohm",
            "Wh",
            "Wh/kg",
            "rpm/V",
            "mAh",
            "1/h"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit",
        "basis",
        "source",
        "regime"
      ],
      "title": "Default",
      "type": "object"
    },
    "Direction": {
      "additionalProperties": false,
      "description": "The direction of a formula (``direction/<id>``).\n\nAttributes:\n    default: The direction of a formula that carries no ``direction/`` tag.",
      "properties": {
        "default": {
          "default": false,
          "title": "Default",
          "type": "boolean"
        },
        "explanation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "explanation"
      ],
      "title": "Direction",
      "type": "object"
    },
    "Discipline": {
      "additionalProperties": false,
      "description": "The question a derived quantity answers (``discipline/<id>``).\n\nAttributes:\n    stability: The discipline is about static stability; its final results are shown after\n        the values of their operating point.",
      "properties": {
        "explanation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "stability": {
          "default": false,
          "title": "Stability",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "explanation"
      ],
      "title": "Discipline",
      "type": "object"
    },
    "Formula": {
      "additionalProperties": false,
      "description": "A canon formula with its applications, checks, worlds and embeds (ch. 8.5, 8.13).\n\nAttributes:\n    kind: The formula's kind.\n    tool: The tool that evaluates it.\n    cost: Cost class: declared in the canon, otherwise derived from ``tool`` (ch. 8.7).\n    inputs: Default quantity per input parameter; ``None`` = bound per application.\n    outputs: Default quantity per output parameter; ``None`` = produced per application.\n    optional: Input parameters that may arrive as ``None``.\n    applications: The applications, at least one.\n    preconditions: Checks on inputs, run before the call.\n    postconditions: Checks on outputs, run after the call.\n    uncertainty: ``interval`` where the formula has method worlds.\n    worlds: The method worlds, exactly with ``uncertainty``.\n    embeds: Directly embedded applications, ``<ns>:<slug>.<application-id>``.\n    variables: Quantities the embedder solves for or sweeps itself, exactly with ``embeds``.\n    embeds_closure: Sorted, unique embeds reachable through ``embeds``, direct ones included.\n    direction: The taxonomy direction (analysis or design); ``None`` only if the taxonomy has none.",
      "properties": {
        "applications": {
          "items": {
            "$ref": "#/$defs/Application"
          },
          "minItems": 1,
          "title": "Applications",
          "type": "array"
        },
        "cost": {
          "enum": [
            "instant",
            "seconds",
            "minutes"
          ],
          "title": "Cost",
          "type": "string"
        },
        "direction": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "embeds": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*([_-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Embeds",
          "type": "array"
        },
        "embeds_closure": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*([_-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Embeds Closure",
          "type": "array"
        },
        "inputs": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(_[a-z0-9]+)*$": {
              "anyOf": [
                {
                  "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "title": "Inputs",
          "type": "object"
        },
        "kind": {
          "enum": [
            "law",
            "procedure",
            "optimization",
            "fit",
            "rating"
          ],
          "title": "Kind",
          "type": "string"
        },
        "optional": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Optional",
          "type": "array"
        },
        "outputs": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(_[a-z0-9]+)*$": {
              "anyOf": [
                {
                  "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "title": "Outputs",
          "type": "object"
        },
        "postconditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Postconditions",
          "type": "array"
        },
        "preconditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "tool": {
          "enum": [
            "APP",
            "ATM",
            "GEO",
            "AB",
            "AVL",
            "OPT",
            "KAT",
            "APC"
          ],
          "title": "Tool",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "const": "interval",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "variables": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Variables",
          "type": "array"
        },
        "worlds": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Worlds",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "tool",
        "cost",
        "inputs",
        "outputs",
        "applications"
      ],
      "title": "Formula",
      "type": "object"
    },
    "Group": {
      "additionalProperties": false,
      "description": "A sub-cluster of a stage (``group/<id>``).\n\nAttributes:\n    parent: The group this one is a part of (the powertrain holds motor, propeller and battery).\n    stage: The stage whose quantities carry this group; ``None`` if the group only has children.\n    module: The module a ``references`` group derives from; ``None`` otherwise.",
      "properties": {
        "explanation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "module": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "stage": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        }
      },
      "required": [
        "id",
        "label",
        "explanation"
      ],
      "title": "Group",
      "type": "object"
    },
    "KernelConfig": {
      "additionalProperties": false,
      "description": "The closed set of the kernel's self-check tolerances (canon ``config.yaml``, gh-1299).",
      "properties": {
        "avl_cl_tolerance": {
          "$ref": "#/$defs/ConfigValue"
        },
        "avl_contour_margin": {
          "$ref": "#/$defs/ConfigValue"
        },
        "avl_control_echo_tolerance": {
          "$ref": "#/$defs/ConfigValue"
        },
        "avl_refinement_tolerance_mac": {
          "$ref": "#/$defs/ConfigValue"
        },
        "avl_roll_branch_tolerance": {
          "$ref": "#/$defs/ConfigValue"
        },
        "avl_roll_moment_tolerance": {
          "$ref": "#/$defs/ConfigValue"
        },
        "avl_roll_print_floor": {
          "$ref": "#/$defs/ConfigValue"
        },
        "avl_roll_refinement_tolerance": {
          "$ref": "#/$defs/ConfigValue"
        },
        "opt_active_bound_fraction": {
          "$ref": "#/$defs/ConfigValue"
        },
        "opt_alpha_margin_deg": {
          "$ref": "#/$defs/ConfigValue"
        },
        "opt_hinge_floor": {
          "$ref": "#/$defs/ConfigValue"
        },
        "opt_peak_tolerance": {
          "$ref": "#/$defs/ConfigValue"
        },
        "opt_probe_tolerance": {
          "$ref": "#/$defs/ConfigValue"
        },
        "opt_zero_span": {
          "$ref": "#/$defs/ConfigValue"
        }
      },
      "required": [
        "avl_refinement_tolerance_mac",
        "avl_roll_refinement_tolerance",
        "avl_roll_branch_tolerance",
        "avl_roll_print_floor",
        "avl_roll_moment_tolerance",
        "avl_control_echo_tolerance",
        "avl_cl_tolerance",
        "opt_probe_tolerance",
        "opt_peak_tolerance",
        "opt_zero_span",
        "opt_active_bound_fraction",
        "opt_alpha_margin_deg",
        "opt_hinge_floor",
        "avl_contour_margin"
      ],
      "title": "KernelConfig",
      "type": "object"
    },
    "Module": {
      "additionalProperties": false,
      "description": "A module groups the inputs and targets (``module/<id>``).\n\nAttributes:\n    cross_cutting: Nearly every formula depends on the module's quantities.\n    holds_targets: The module's quantities are targets (role ``target``), and only these.",
      "properties": {
        "cross_cutting": {
          "default": false,
          "title": "Cross Cutting",
          "type": "boolean"
        },
        "explanation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "holds_targets": {
          "default": false,
          "title": "Holds Targets",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "explanation"
      ],
      "title": "Module",
      "type": "object"
    },
    "Namespace": {
      "additionalProperties": false,
      "description": "One canon of the model: its quantities, formulas and defaults, keyed by bare slug.\n\nAttributes:\n    quantities: The quantity vocabulary.\n    formulas: The formulas.\n    defaults: The stated default per supplied scalar quantity (or fallback of a catalogue read); absent = the caller must supply it.\n    rules: The validation rules with their overridable parameters (``rules.yaml``).\n    config: The kernel's self-check tolerances (``config.yaml``); never overridable.\n    taxonomy: The vocabulary of the tag families, with the world-to-tool mapping.",
      "properties": {
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/KernelConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "defaults": {
          "default": {},
          "patternProperties": {
            "^[a-z][a-z0-9]*(-[a-z0-9]+)*$": {
              "$ref": "#/$defs/Default"
            }
          },
          "title": "Defaults",
          "type": "object"
        },
        "formulas": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(-[a-z0-9]+)*$": {
              "$ref": "#/$defs/Formula"
            }
          },
          "title": "Formulas",
          "type": "object"
        },
        "quantities": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(-[a-z0-9]+)*$": {
              "$ref": "#/$defs/Quantity"
            }
          },
          "title": "Quantities",
          "type": "object"
        },
        "rules": {
          "default": {},
          "patternProperties": {
            "^[a-z][a-z0-9]*(-[a-z0-9]+)*$": {
              "$ref": "#/$defs/Rule"
            }
          },
          "title": "Rules",
          "type": "object"
        },
        "taxonomy": {
          "$ref": "#/$defs/Taxonomy",
          "default": {
            "directions": [],
            "disciplines": [],
            "groups": [],
            "modules": [],
            "points": [],
            "stages": [],
            "tools": [],
            "worlds": []
          }
        }
      },
      "required": [
        "quantities",
        "formulas"
      ],
      "title": "Namespace",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "description": "An operating point or configuration a final result belongs to (``point/<id>``).",
      "properties": {
        "explanation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "explanation"
      ],
      "title": "Point",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "A quantity of the canon vocabulary.\n\nAttributes:\n    symbol: The quantity's symbol.\n    unit: The unit of its values; ``1`` is dimensionless.\n    role: ``input`` and ``target`` are supplied by the caller, ``derived`` and ``output`` computed.\n    type: The kind of value.\n    uncertainty: ``interval`` where the producer declares method worlds.\n    positive: ``True`` where the quantity is strictly greater than zero by its definition,\n        otherwise omitted (``None``); ``false`` is no spelling of the canon.\n    module: The taxonomy module of an input, target or reference; ``None`` where the quantity has none.\n    point: The taxonomy operating point of a final result.\n    stage: The taxonomy stage of an intermediate quantity.\n    group: The taxonomy group of a quantity inside its stage.\n    discipline: The taxonomy discipline of a derived quantity.\n    checks: The slug of the quantity this one verifies (a probe); ``None`` for any other.\n    at_most: The largest admissible value of a supplied scalar (an efficiency is at most 1),\n        otherwise omitted (``None``).\n    data: Where the quantity comes from in our data, each ``<kind>:<location>`` (a quantity no\n        formula produces; stage 2 of the approval); ``None`` while it has no demonstrated source.",
      "properties": {
        "at_most": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At Most"
        },
        "checks": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checks"
        },
        "data": {
          "anyOf": [
            {
              "items": {
                "pattern": "^(geometry|component|default|app|evaluation):\\S+$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "discipline": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discipline"
        },
        "group": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "module": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "point": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point"
        },
        "positive": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positive"
        },
        "role": {
          "enum": [
            "input",
            "target",
            "derived",
            "output"
          ],
          "title": "Role",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "symbol": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Symbol",
          "type": "string"
        },
        "type": {
          "enum": [
            "scalar",
            "airplane",
            "components",
            "curve",
            "polar",
            "curve_pair",
            "per_control_surface"
          ],
          "title": "Type",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "const": "interval",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "unit": {
          "enum": [
            "1",
            "m",
            "m^2",
            "kg",
            "s",
            "deg",
            "deg/s",
            "m/s",
            "m/s^2",
            "1/s",
            "1/rad",
            "1/rad^2",
            "N",
            "N/m^2",
            "N*m",
            "N/m",
            "Pa",
            "Pa*s",
            "kg/m^3",
            "W",
            "V",
            "A",
            "ohm",
            "Wh",
            "Wh/kg",
            "rpm/V",
            "mAh",
            "1/h"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "unit",
        "role",
        "type"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "description": "A validation rule: a requirement on the input data or a limit of a tool (gh-1260).\n\nAttributes:\n    applies_to: The input quantity or the formula the rule guards.\n    kind: ``input`` (a requirement on the data), ``tool`` (a stated limit of a tool) or ``probe``\n        (the agreement tolerance of a probe with the value it checks).\n    on_violation: ``error`` refuses the input, ``warning`` declares it.\n    criterion: The criterion in words, with the thresholds named by their parameter.\n    parameters: The thresholds, by name; the caller may override an adopted one.\n    codes: The error codes the kernel reports for a violation (the rule's trace into the code); empty\n        while the kernel has no check for it yet.",
      "properties": {
        "applies_to": {
          "$ref": "#/$defs/RuleTarget"
        },
        "codes": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Codes",
          "type": "array"
        },
        "criterion": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Criterion",
          "type": "string"
        },
        "kind": {
          "enum": [
            "input",
            "tool",
            "probe"
          ],
          "title": "Kind",
          "type": "string"
        },
        "on_violation": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "On Violation",
          "type": "string"
        },
        "parameters": {
          "default": {},
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/RuleParameter"
            }
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "applies_to",
        "kind",
        "on_violation",
        "criterion"
      ],
      "title": "Rule",
      "type": "object"
    },
    "RuleParameter": {
      "additionalProperties": false,
      "description": "A threshold of a validation rule, with its unit, basis, status, source and regime.\n\nAttributes:\n    value: The value, in ``unit``.\n    unit: The unit of ``value``.\n    basis: ``definition``, ``standard``, ``sourced`` or ``convention`` (chosen, adopted on the\n        maintainer's word).\n    status: ``adopted``, or ``pending`` while it is a proposal the maintainer has not decided.\n    source: Where the value comes from.\n    regime: Why it holds in the RC/UAV regime (ADR 0028).",
      "properties": {
        "basis": {
          "enum": [
            "definition",
            "standard",
            "sourced",
            "convention"
          ],
          "title": "Basis",
          "type": "string"
        },
        "regime": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Regime",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "adopted",
            "pending"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "enum": [
            "1",
            "m",
            "m^2",
            "kg",
            "s",
            "deg",
            "deg/s",
            "m/s",
            "m/s^2",
            "1/s",
            "1/rad",
            "1/rad^2",
            "N",
            "N/m^2",
            "N*m",
            "N/m",
            "Pa",
            "Pa*s",
            "kg/m^3",
            "W",
            "V",
            "A",
            "ohm",
            "Wh",
            "Wh/kg",
            "rpm/V",
            "mAh",
            "1/h"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit",
        "basis",
        "status",
        "source",
        "regime"
      ],
      "title": "RuleParameter",
      "type": "object"
    },
    "RuleTarget": {
      "additionalProperties": false,
      "description": "What a rule guards: one quantity (an input) or one formula, exactly one of the two.\n\nAttributes:\n    quantity: Slug of the input quantity the rule guards (``airplane``).\n    formula: Slug of the formula the rule is a precondition of.",
      "properties": {
        "formula": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formula"
        },
        "quantity": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        }
      },
      "title": "RuleTarget",
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "description": "A role in the calculation chain an intermediate quantity has (``stage/<id>``).\n\nAttributes:\n    reference: The stage holds references: values derived from the inputs of a module. Their\n        quantities carry a module and a group, and no discipline.",
      "properties": {
        "explanation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "reference": {
          "default": false,
          "title": "Reference",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "explanation"
      ],
      "title": "Stage",
      "type": "object"
    },
    "Taxonomy": {
      "additionalProperties": false,
      "description": "Every value of every tag family, in display order.\n\nA family without values is not used by the canon that carries this taxonomy: its tags are\nneither accepted nor required.\n\nAttributes:\n    modules: Modules of inputs and targets.\n    points: Operating points of final results.\n    stages: Stages of intermediate quantities, in the order of the calculation chain.\n    groups: Sub-clusters of the stages.\n    disciplines: The questions derived quantities answer.\n    directions: Formula directions.\n    tools: Tool codes with names.\n    worlds: Method worlds with their tool.",
      "properties": {
        "directions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Direction"
          },
          "title": "Directions",
          "type": "array"
        },
        "disciplines": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Discipline"
          },
          "title": "Disciplines",
          "type": "array"
        },
        "groups": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Group"
          },
          "title": "Groups",
          "type": "array"
        },
        "modules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Module"
          },
          "title": "Modules",
          "type": "array"
        },
        "points": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Point"
          },
          "title": "Points",
          "type": "array"
        },
        "stages": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Stage"
          },
          "title": "Stages",
          "type": "array"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolInfo"
          },
          "title": "Tools",
          "type": "array"
        },
        "worlds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/World"
          },
          "title": "Worlds",
          "type": "array"
        }
      },
      "title": "Taxonomy",
      "type": "object"
    },
    "ToolInfo": {
      "additionalProperties": false,
      "description": "A tool code with its name.\n\nAttributes:\n    id: The tool code a formula's ``tool`` field holds.\n    name: The tool's name as shown to readers.",
      "properties": {
        "id": {
          "enum": [
            "APP",
            "ATM",
            "GEO",
            "AB",
            "AVL",
            "OPT",
            "KAT",
            "APC"
          ],
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ToolInfo",
      "type": "object"
    },
    "World": {
      "additionalProperties": false,
      "description": "A method world with the tool that computes it.\n\nAttributes:\n    id: The world name a formula's ``worlds`` field holds.\n    tool: The tool whose version and settings the world's result depends on.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "tool": {
          "enum": [
            "APP",
            "ATM",
            "GEO",
            "AB",
            "AVL",
            "OPT",
            "KAT",
            "APC"
          ],
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tool"
      ],
      "title": "World",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The interpreted canon the kernel runs on (ch. 8.9); the content of ``canon_model.json``.\n\nAttributes:\n    schema_version: Version of this model shape; ``2``.\n    content_hash: Hash of ``namespaces`` (see :func:`compute_content_hash`).\n    importer_version: Version of the importer that wrote the model.\n    namespaces: Quantities and formulas per namespace; every reference inside is qualified.",
  "properties": {
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "importer_version": {
      "minLength": 1,
      "title": "Importer Version",
      "type": "string"
    },
    "namespaces": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/Namespace"
        }
      },
      "title": "Namespaces",
      "type": "object"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "content_hash",
    "importer_version",
    "namespaces"
  ],
  "title": "CanonModel",
  "type": "object"
}
