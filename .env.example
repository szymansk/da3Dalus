# Example environment configuration for cad-modelling-service.
# Copy this file to `.env` and fill in the values you need.
# `.env` is gitignored — NEVER commit real secrets.

# --- Database ---------------------------------------------------------------
# SQLAlchemy connection URL. Defaults to a local SQLite file if unset
# (see app/db/session.py). Override in production.
# Examples:
#   sqlite:///./db/test.db
#   postgresql+psycopg2://user:pass@localhost:5432/da3dalus
SQLALCHEMY_DATABASE_URL=sqlite:///./db/test.db

# --- Logging ----------------------------------------------------------------
# Python logging level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Read by app/logging_config.py.
LOG_LEVEL=INFO

# --- Headless rendering (visualisation / 3-view / streamline plots) ---------
# Path to a Chromium-compatible browser used by headless rendering flows.
# On the provided Docker image this is /usr/bin/chromium.
BROWSER_PATH=/usr/bin/chromium

# Qt platform for headless rendering. Keep as "offscreen" on servers.
QT_QPA_PLATFORM=offscreen

# --- CadQuery live viewer (optional, local development only) ---------------
# Host and port of a running ocp-vscode viewer. Used by
# cad_designer/cq_plugins/display/display.py to preview CAD during dev.
# Leave at defaults if you don't run the viewer.
OCP_VSCODE_HOST=127.0.0.1
OCP_VSCODE_PORT=3939

# --- Uvicorn ----------------------------------------------------------------
# Host address for the uvicorn dev server (run_app). Defaults to 127.0.0.1.
# Set to 0.0.0.0 in Docker/production to accept external connections.
UVICORN_HOST=127.0.0.1

# --- Debug flags ------------------------------------------------------------
# When set to 1/ON/TRUE/ENABLED, decorated debug functions emit intermediate
# CAD steps during construction (see cad_designer/decorators/general_decorators.py
# and the conditional_execute decorator). Leave unset in production.
# DISPLAY_CONSTRUCTION_STEP=

  # --- SonarQube / SonarCloud -------------------------------------------------
  # Authentication token for the SonarCloud API. Used by supercycle skills
  # to fetch quality-gate results. Generate at https://sonarcloud.io/account/security
  # SONAR_TOKEN=

# --- Low-Re airfoil scoring tuning (gh-825) --------------------------------
# Relative drag-rise r = CD(CL_target)/cd0 at which Match score → 0.
# Default 2.5 means: CD at target = 2.5 × cd0 earns zero credit.
# LOW_RE_SCORE_R_POOR=2.5
#
# Drag-bucket width (ΔCL at CD ≤ 1.15·cd_min) that earns full tolerance credit.
# A wider bucket yields a wider sweet-spot acceptance band in the Match formula.
# Default 0.6 corresponds to an excellent low-Re airfoil bucket.
# LOW_RE_BUCKET_TOLERANCE_REF=0.6

# --- AI Copilot / model hub (#902) ------------------------------------------
# The in-app copilot reaches LLMs through a LiteLLM-based ai-hub that is
# OpenAI-compatible. The backend will use an OpenAI-style client pointed at the
# hub (read via app/core/config.py). Put the real values in `.env` (gitignored);
# NEVER commit the key here.
#
# Hub API key (secret):
# COPILOT_API_KEY=
#
# Hub endpoint — OpenAI-compatible base URL, usually ends in /v1
# (e.g. https://your-litellm-hub.example.com/v1):
# COPILOT_BASE_URL=
#
# Default chat/agent model id to route through the hub (the hub's model name).
# Recommended: claude-sonnet-4-6 (good agentic balance) or claude-opus-4-7
# (strongest reasoning). The hub also passes through streaming + tool-calls.
# COPILOT_MODEL=claude-sonnet-4-6
#
# Embedding model — OPTIONAL / not on the critical path. The original
# embedding-RAG idea was superseded by #929 (agentic expert panel): each
# expert keeps its own vault and uses lexical retrieval (ripgrep + BM25 +
# link-graph), no embeddings. Set this only if a later semantic re-rank is
# added on top.
# COPILOT_EMBEDDING_MODEL=text-embedding-3-large
#
# Available models on the adesso ai-hub (2026-06, names = hub routing ids):
#   Claude (EU-hosted):  claude-opus-4-7  claude-opus-4-6  claude-opus-4-5
#                        claude-sonnet-4-6  claude-sonnet-4-5  claude-haiku-4-5
#   Sovereign (DE, free): qwen-3.5-122b-sovereign  qwen-3.6-35b-sovereign  (200k ctx)
#   GPT (Azure EU):      gpt-5.1  gpt-5  gpt-5-mini  gpt-5-nano  gpt-4.1
#                        gpt-4.1-mini  gpt-4.1-nano  gpt-4o  o4-mini  o3-mini
#   Gemini (EU):         gemini-3.5-flash  gemini-2.5-pro  gemini-2.5-flash
#   Coding/OSS:          qwen3-coder-480b  qwen3-235b  devstral-2-123b
#                        gpt-oss-120b  gpt-oss-20b  google/gemma-3-27b-it  llama-3-3-70b
#   Embeddings:          text-embedding-3-large (EU)  intfloat/e5-mistral-7b-instruct (DE)
#                        qwen-3-vl-embedding-2b-sovereign (DE)
                      