{
  "typeCheckingMode": "basic",
  "venvPath": ".",
  "venv": ".venv",
  "include": [
    "app",
    "aero_kernel"
  ],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "app/tests",
    "alembic",
    "frontend",
    "scripts",
    "cad_designer"
  ],
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "strict": [
    "aero_kernel"
  ]
}
